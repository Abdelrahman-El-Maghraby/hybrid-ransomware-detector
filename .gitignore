# --- Secrets (NEVER commit) ---
.env
*.key
secrets.*

# --- Datasets / large data (provide a link in the README instead) ---
*.csv
*.csv~
data_file*
/data/
/datasets/

# --- Scanner runtime output ---
scan_reports/
*.log
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.quar
keystore/
quarantine/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Misc heavy/binary files that shouldn't live in a code repo ---
*.mp4
*.zip
*.rar
*.docx
*.dotx
*.pptx

# --- Builds (python build.py) ---
/build/
/dist/

# --- Trained ML models (pickle files: never load one you didn't train) ---
*.joblib
