# TLS in front of the analysis service, which listens only on a Unix socket.
# Put your certificate and key in AEGIS_TLS_DIR (docs/DEPLOYMENT.md).
{
	admin off
	auto_https off
}

:8443 {
	tls /etc/caddy/tls/cert.pem /etc/caddy/tls/key.pem
	request_body {
		max_size 52MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
	# Caddy sets X-Forwarded-For to the real peer and drops what an untrusted
	# client sent (no trusted_proxies here), so the API sees the true address.
	reverse_proxy unix//run/aegis/api/api.sock
}
