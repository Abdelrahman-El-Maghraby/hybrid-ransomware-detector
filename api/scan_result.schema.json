{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Abdelrahman-El-Maghraby/hybrid-ransomware-detector/api/scan_result.schema.json",
  "title": "Aegis Sentinel scan result",
  "description": "One scanned file. Integrations should key on schema_version: fields are only ever added within a major version; renames or removals bump it. Layer-specific details live under scan_results and may grow with new layers.",
  "type": "object",
  "required": ["schema_version", "file_path", "file_name", "engine_version", "sha256_hash",
               "risk_score", "verdict", "is_malicious", "score_breakdown", "scan_results"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "file_path": {"type": "string", "description": "Path as scanned; container members appear as outer!/inner."},
    "file_name": {"type": "string"},
    "file_size": {"type": "integer", "minimum": 0},
    "scan_time": {"type": "string"},
    "engine_version": {"type": "string"},
    "md5_hash": {"type": "string", "pattern": "^([0-9a-f]{32})?$"},
    "sha256_hash": {"type": "string", "pattern": "^([0-9a-f]{64})?$"},
    "is_malicious": {"type": "boolean"},
    "severity_score": {"type": "number", "minimum": 0, "maximum": 10},
    "risk_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "verdict": {"enum": ["Clean", "Low", "Medium", "High", "Critical"]},
    "score_breakdown": {
      "type": "object",
      "required": ["risk_score", "verdict", "contributions"],
      "properties": {
        "risk_score": {"type": "integer", "minimum": 0, "maximum": 100},
        "severity_score": {"type": "number"},
        "verdict": {"enum": ["Clean", "Low", "Medium", "High", "Critical"]},
        "is_malicious": {"type": "boolean"},
        "registry_version": {"type": "string"},
        "category_totals": {"type": "object", "additionalProperties": {"type": "number"}},
        "contributions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["indicator", "category", "points", "detail"],
            "properties": {
              "indicator": {"type": "string", "pattern": "^[a-z_]+(:[a-z_]+)*$"},
              "category": {"enum": ["technical", "reputation", "semantic", "statistical", "dynamic"]},
              "points": {"type": "number", "minimum": 0},
              "detail": {"type": "string"}
            }
          }
        }
      }
    },
    "scan_duration_ms": {"type": "integer", "minimum": 0, "description": "Wall-clock time of the scan in milliseconds (schema 1.1)."},
    "scan_status": {"enum": ["complete", "partial", "locked", "unsupported", "failed"], "description": "How far the evidence goes, independent of risk_score and verdict (schema 1.2). complete: every applicable, enabled layer ran; partial: an applicable layer errored or was unavailable, or content was not unpacked; locked: encrypted content was not opened; unsupported: the format has no type-specific analysis; failed: the worker timed out, crashed or ran out of memory. A container takes its most severe member status: failed > locked > partial > unsupported > complete."},
    "incomplete_reasons": {
      "type": "array",
      "description": "Every gap behind a scan_status other than complete (schema 1.2).",
      "items": {
        "type": "object",
        "required": ["member_path", "layer", "reason"],
        "properties": {
          "member_path": {"type": "string", "description": "The file or container member the gap is in (outer!/inner)."},
          "layer": {"type": "string"},
          "reason": {"type": "string"},
          "status": {"enum": ["partial", "locked", "unsupported", "failed"]}
        }
      }
    },
    "provenance": {
      "type": "object",
      "description": "What produced this result (schema 1.2). Never contains keys, tokens, passwords or service URLs.",
      "properties": {
        "engine_version": {"type": "string"},
        "schema_version": {"type": "string"},
        "registry_version": {"type": "string"},
        "rules": {"type": "object", "properties": {
          "source": {"enum": ["bundled", "rule pack", "custom folder", "none"]},
          "version": {"type": "string"}, "files": {"type": "integer", "minimum": 0},
          "compiled": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^([0-9a-f]{64})?$"}}},
        "fuzzy_signatures": {"type": "object"},
        "profile": {"enum": ["standard", "production"]},
        "external_services": {"type": "object", "additionalProperties": {"type": "string"},
                              "description": "llm / virustotal / sandbox: 'off' or how each is used."},
        "layers_disabled": {"type": "array", "items": {"type": "object", "required": ["layer", "reason"]}},
        "layers_down": {"type": "array", "items": {"type": "object", "required": ["layer", "reason"]}},
        "layers_run": {"type": "array", "items": {"type": "string"}},
        "layers_unavailable": {"type": "array", "items": {"type": "string"}},
        "layers_not_applicable": {"type": "array", "items": {"type": "string"}},
        "layers_failed": {"type": "array", "items": {"type": "string"}},
        "layers_skipped": {"type": "array", "items": {"type": "object", "required": ["layer", "reason"]}}
      }
    },
    "verdict_label": {"type": "string", "description": "The verdict as it should be shown: 'Clean (partial scan)' when scan_status is not complete (schema 1.2)."},
    "scan_results": {"type": "object", "description": "Per-layer evidence (hashes, yara, mail, archive, ...)."}
  }
}
