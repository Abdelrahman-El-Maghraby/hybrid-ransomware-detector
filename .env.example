# Copy this file to ".env" and fill in your own keys.
# The .env file is git-ignored and must NEVER be committed.

# ---- LLM semantic-analysis layer -------------------------------------------
# Backend selection: auto | ollama | openai | none
#   auto   (default) prefer a reachable local Ollama for OPSEC; fall back to
#          OpenAI only if no local model is up AND OPENAI_API_KEY is set.
#   ollama force local-only (documents never leave the machine).
#   openai force cloud (requires OPENAI_API_KEY).
#   none   disable the semantic layer entirely.
LLM_PROVIDER=auto

# Local Ollama (used by 'auto' / 'ollama'). Install from https://ollama.com,
# then e.g.  ollama pull llama3.1
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OpenAI (used by 'auto' fallback / 'openai'). Optional — leave blank to keep
# everything local. Sending documents to the cloud is logged as egress.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# ---- VirusTotal multi-engine reputation layer ------------------------------
VIRUSTOTAL_API_KEY=your-virustotal-api-key-here

# ---- Detection-layer data (optional overrides) -----------------------------
# Path to your fuzzy signature database (defaults to the bundled sample).
# FUZZY_SIGNATURE_DB=/path/to/fuzzy_signatures.json
# Directory of YARA rules (.yar/.yara) to compile (defaults to ./rules).
# YARA_RULES_DIR=/path/to/rules

# ---- VirusTotal privacy & pacing -------------------------------------------
# By default only the file's SHA-256 is looked up. Uploading an unknown file
# shares its full content with VirusTotal (and its Enterprise subscribers).
VT_UPLOAD_UNKNOWN=false
# Free public API = 4 requests/minute. Raise for a premium key, 0 = no pacing.
VT_REQUESTS_PER_MINUTE=4
# Timeout (seconds) for every external HTTP call.
HTTP_TIMEOUT=30

# ---- Result cache (VirusTotal + LLM answers keyed by SHA-256) --------------
CACHE_ENABLED=true
CACHE_TTL_HOURS=24

# ---- Protection --------------------------------------------------------------
# Quarantine files automatically after a scan: empty (off) | high | critical
AUTO_QUARANTINE=
# How often the background scanner / GUI re-checks the canary files.
CANARY_CHECK_MINUTES=5

# ---- ML classifier (v4.1) ----------------------------------------------------
# On by default. Without a trained model it uses a transparent rule engine.
ML_ENABLED=true
# Model produced by: python RansomwareScanner.py --train-ml BENIGN_DIR MALICIOUS_DIR
# (joblib = pickle: only point this at a model you trained yourself.)
# ML_MODEL_PATH=/path/to/ml_model.joblib

# --- 4.4.0-beta.2 ---------------------------------------------------------------
# Known-good files (one SHA-256 per line, "# note" allowed). Add with --allow FILE.
# ALLOWLIST_PATH=/path/to/allowlist.txt
# Optional self-hosted CAPEv2 sandbox. Empty = off; files go only to this URL.
# SANDBOX_URL=http://cape.lab:8000
# SANDBOX_TOKEN=
# SANDBOX_SUBMIT=suspicious        # or: all
# SANDBOX_WAIT_SECONDS=600
# Slow layers: skip at a score of 100, run concurrently otherwise
# SKIP_HEAVY_WHEN_SATURATED=true
# PARALLEL_HEAVY_LAYERS=true
# QR_SCAN_ENABLED=true
# SIEM / SOC outputs
# JSONL_PATH=/var/log/aegis/results.jsonl
# WEBHOOK_URL=https://soar.example/hooks/aegis
# WEBHOOK_SECRET=                    # HMAC-SHA256 signature in X-Aegis-Signature
# WEBHOOK_MIN_VERDICT=High
# REST API (pip install -e ".[api]"; run: aegis-api)
# AEGIS_API_TOKEN=                   # required, 16+ random characters
# AEGIS_API_HOST=127.0.0.1
# AEGIS_API_PORT=8765
# AEGIS_API_MAX_UPLOAD_MB=50
# Isolated folder scans
# ISOLATE_SCANS=true
# SCAN_WORKERS=0                     # 0 = automatic (up to 4; 1 with a free VirusTotal key)
# SCAN_TIMEOUT_SECONDS=300
# WORKER_MEMORY_MB=2048
# WEIGHTS_OVERRIDE=                  # reviewed weights file from tools/calibrate_weights.py
# Signed rule packs (python RansomwareScanner.py --update-rules pack.tar.gz)
# RULEPACK_PUBLIC_KEYS=<base64 Ed25519 public key>[,<another>]
