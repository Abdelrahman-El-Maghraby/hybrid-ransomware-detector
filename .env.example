# Copy this file to ".env" and fill in your own keys.
# The .env file is git-ignored and must NEVER be committed.

# ---- Secrets (4.7) -------------------------------------------------------------
# OPENAI_API_KEY, VIRUSTOTAL_API_KEY, SANDBOX_TOKEN, WEBHOOK_SECRET, IMAP_PASSWORD and SMTP_PASSWORD
# are read, first match wins, from: the environment (NAME, or NAME_FILE pointing at a
# file such as a Docker secret in /run/secrets), the OS keyring (the desktop app saves
# keys there), then this file. On a desktop, secrets found here are moved to the OS
# keyring on the next start (written, read back, then removed from this file).
# ---- LLM semantic-analysis layer -------------------------------------------
# Backend selection: auto | ollama | openai | none
#   auto   (default) prefer a reachable local Ollama for OPSEC; fall back to
#          OpenAI only if no local model is up AND OPENAI_API_KEY is set.
#   ollama force local-only (documents never leave the machine).
#   openai force cloud (requires OPENAI_API_KEY).
#   none   disable the semantic layer entirely.
LLM_PROVIDER=auto

# Local Ollama (used by 'auto' / 'ollama'). Install from https://ollama.com,
# then e.g.  ollama pull llama3.1
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OpenAI (used by 'auto' fallback / 'openai'). Optional — leave blank to keep
# everything local. Sending documents to the cloud is logged as egress.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# ---- VirusTotal multi-engine reputation layer ------------------------------
VIRUSTOTAL_API_KEY=your-virustotal-api-key-here

# ---- Detection-layer data (optional overrides) -----------------------------
# Path to your fuzzy signature database (defaults to the bundled sample).
# FUZZY_SIGNATURE_DB=/path/to/fuzzy_signatures.json
# Directory of YARA rules (.yar/.yara) to compile (defaults to ./rules).
# YARA_RULES_DIR=/path/to/rules

# ---- VirusTotal privacy & pacing -------------------------------------------
# By default only the file's SHA-256 is looked up. Uploading an unknown file
# shares its full content with VirusTotal (and its Enterprise subscribers).
VT_UPLOAD_UNKNOWN=false
# Free public API = 4 requests/minute. Raise for a premium key, 0 = no pacing.
VT_REQUESTS_PER_MINUTE=4
# Timeout (seconds) for every external HTTP call.
HTTP_TIMEOUT=30

# ---- Result cache (VirusTotal + LLM answers keyed by SHA-256) --------------
CACHE_ENABLED=true
CACHE_TTL_HOURS=24

# ---- Protection --------------------------------------------------------------
# Quarantine files automatically after a scan: empty (off) | high | critical
AUTO_QUARANTINE=
# How often the background scanner / GUI re-checks the canary files.
CANARY_CHECK_MINUTES=5
# What to do on a NEW canary trip, besides the alert. Empty = alert only.
# A tripwire fires after encryption has started: these actions limit the damage,
# they are not kernel-level prevention. They always run in this order:
#   stop_writers   suspend the processes writing in the canary folders and their
#                  children (4.6.0; undo: --resume-pid PID[,PID])
#   lock_folders   remove write access to CANARY_LOCK_DIRS (4.6.0; undo: --unlock-folders)
#   controlled_folder_access  Windows: turn on Defender Controlled Folder Access (admin)
#   network_off    disable network adapters (needs admin/root)
#   script         run CANARY_RESPONSE_SCRIPT (absolute path, owner-only writable)
#                  with the alert as JSON on stdin
# CANARY_RESPONSE=stop_writers,lock_folders,network_off
# CANARY_CONTAIN_MODE=suspend        # or terminate
# CANARY_CONTAIN_EXCLUDE=            # extra process names never to stop (e.g. a sync client)
# CANARY_LOCK_DIRS=                  # ; separated (also : on macOS/Linux); default: canary folders
# CANARY_RESPONSE_SCRIPT=/usr/local/bin/isolate-host.sh

# ---- Logging (4.6.0) -------------------------------------------------------------
# LOG_FORMAT=text                    # json = one JSON object per line for log shippers
# LOG_LEVEL=INFO

# ---- Mailbox scanning over IMAP (4.5.0) -------------------------------------------
# Read-only (EXAMINE + BODY.PEEK) and TLS only. Use an app password.
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_STARTTLS=false              # true for port 143 + STARTTLS
# IMAP_USER=you@example.com
# IMAP_PASSWORD=
# IMAP_FOLDER=INBOX
# IMAP_SINCE_DAYS=7                # first run looks this far back
# IMAP_MAX_MESSAGES=200            # per run
# IMAP_MAX_MB=25                   # larger messages are skipped and listed
# IMAP_CHECK_MINUTES=0             # with --background: check every N minutes (0 = off)

# ---- JavaScript emulation with box-js (4.5.0) -------------------------------------
# Runs the attacker's script in a Node sandbox: enable inside an analysis VM only.
# npm install -g box-js
# EMULATION_ENABLED=false
# EMULATION_TOOL=box-js
# EMULATION_TIMEOUT=20

# ---- ML classifier (v4.1) ----------------------------------------------------
# On by default. Without a trained model it uses a transparent rule engine.
ML_ENABLED=true
# Model produced by: python RansomwareScanner.py --train-ml BENIGN_DIR MALICIOUS_DIR
# (joblib = pickle: only point this at a model you trained yourself.)
# ML_MODEL_PATH=/path/to/ml_model.joblib

# --- 4.4.0-beta.2 ---------------------------------------------------------------
# Known-good files (one SHA-256 per line, "# note" allowed). Add with --allow FILE.
# ALLOWLIST_PATH=/path/to/allowlist.txt
# Optional self-hosted CAPEv2 sandbox. Empty = off; files go only to this URL.
# SANDBOX_URL=http://cape.lab:8000
# SANDBOX_TOKEN=
# SANDBOX_SUBMIT=suspicious        # or: all
# SANDBOX_WAIT_SECONDS=600
# Slow layers: skip at a score of 100, run concurrently otherwise
# SKIP_HEAVY_WHEN_SATURATED=true
# PARALLEL_HEAVY_LAYERS=true
# QR_SCAN_ENABLED=true
# SIEM / SOC outputs
# JSONL_PATH=/var/log/aegis/results.jsonl
# WEBHOOK_URL=https://soar.example/hooks/aegis
# WEBHOOK_SECRET=                    # HMAC-SHA256 signature in X-Aegis-Signature
# WEBHOOK_MIN_VERDICT=High
# Alerts (webhook, e-mail, canary trips) are kept in an outbox and retried until
# delivered or older than OUTBOX_MAX_AGE_HOURS (4.8)
# OUTBOX_DIR=                        # default: <app folder>/outbox
# OUTBOX_MAX_AGE_HOURS=24
# E-mail alerts (4.8): metadata only (verdict, hash, file name, reason codes), over TLS
# with certificate verification; no plaintext option. In Docker these are set on the
# intel service (docker-compose.yml), never on the analysis service.
# SMTP_HOST=smtp.example.org
# SMTP_PORT=465
# SMTP_SECURITY=tls                  # tls (implicit, 465) or starttls (required, 587)
# SMTP_USER=alerts@example.org
# SMTP_PASSWORD=                     # a secret: keyring, environment or SMTP_PASSWORD_FILE
# ALERT_EMAIL_FROM=aegis@example.org
# ALERT_EMAIL_TO=soc@example.org,oncall@example.org
# ALERT_EMAIL_MIN_VERDICT=High
# ALERT_EMAIL_PER_HOUR=20
# ALERT_EMAIL_PER_DAY=100
# Optional cloud storage of reports and logs (4.8, desktop only, off by default): a
# redacted upload view (no paths, file names, user or host names, no free text) to one
# S3-compatible bucket over HTTPS. Keep the credential to "create objects under this
# installation's prefix"; set retention (90 days) and versioning / object lock on the
# bucket. See docs/OPERATIONS.md and docs/DATA_POLICY.md.
# CLOUD_UPLOAD=false
# CLOUD_ENDPOINT=https://s3.eu-west-1.amazonaws.com
# CLOUD_REGION=eu-west-1
# CLOUD_BUCKET=aegis-reports
# CLOUD_PREFIX=aegis
# CLOUD_ACCESS_KEY_ID=
# CLOUD_SECRET_ACCESS_KEY=           # a secret: keyring, environment or _FILE
# CLOUD_CA_BUNDLE=                   # a private CA for an on-prem endpoint (optional)
# CLOUD_CONDITIONAL_WRITES=true      # create-only (If-None-Match: *) where supported
# CLOUD_UPLOAD_FULL=false            # true uploads paths and names too (recorded, warned)
# CLOUD_SPOOL_DAYS=30                # local copies waiting for upload
# CLOUD_SPOOL_MAX_MB=1024
# Edition profile (4.7): "production" is the supported on-prem configuration. It refuses to
# start with a required layer disabled, and GET /ready reports a required layer that is down.
# AEGIS_PROFILE=standard
# REST API (pip install -e ".[api]"; run: aegis-api)
# AEGIS_API_TOKEN=                   # required, 16+ random characters (or AEGIS_API_TOKEN_FILE)
# AEGIS_API_HOST=127.0.0.1
# AEGIS_API_PORT=8765
# AEGIS_API_SOCKET=                  # listen on this Unix socket instead (the Docker deployment)
# AEGIS_API_MAX_UPLOAD_MB=50
# AEGIS_API_IP_RATE_PER_MINUTE=120   # per IP address, before authentication; 0 = no limit
# AEGIS_API_IP_BURST=30
# AEGIS_API_AUTH_FAILURES=5          # wrong tokens from one address within the window ...
# AEGIS_API_AUTH_WINDOW_SECONDS=300
# AEGIS_API_AUTH_LOCKOUT_SECONDS=900 # ... lock it out for this long (429 + Retry-After)
# AEGIS_API_RATE_PER_MINUTE=60       # per authenticated client (IP + valid token); 0 = no limit
# AEGIS_API_BURST=10
# AEGIS_API_MAX_CONCURRENT_SCANS=2   # more at once get 503 + Retry-After
# AEGIS_API_SPARE_WORKERS=           # workers started ahead (default: one per scan slot; 0 = off).
#                                    # Each upload still gets a fresh one; ~200 MB idle each
# AEGIS_API_TRUST_PROXY=0            # 1 behind ONE reverse proxy (uses the last X-Forwarded-For entry)
# Intel service (Docker): the only part with network access; see docs/DEPLOYMENT.md
# AEGIS_INTEL_SOCKET=                # analysis: reach VirusTotal / LLM / sandbox through it
# AEGIS_INTEL_TOKEN=                 # shared by both sides, 32+ random characters (or _FILE)
# AEGIS_INTEL_RATE_PER_MINUTE=120    # intel: per operation
# AEGIS_INTEL_BURST=20
# AEGIS_INTEL_MAX_UPLOAD_MB=100
# CACHE_DB_PATH=                     # result cache file (default: in the data folder)
# Log file rotation (the console / docker logs are separate)
# LOG_MAX_MB=20
# LOG_BACKUPS=5
# Isolated folder scans
# ISOLATE_SCANS=true
# SCAN_WORKERS=0                     # 0 = automatic (up to 4; 1 with a free VirusTotal key)
# SCAN_TIMEOUT_SECONDS=300
# WORKER_MEMORY_MB=2048
# WEIGHTS_OVERRIDE=                  # reviewed weights file from tools/calibrate_weights.py
# Signed rule packs (python RansomwareScanner.py --update-rules pack.tar.gz)
# RULEPACK_PUBLIC_KEYS=<base64 Ed25519 public key>[,<another>]
