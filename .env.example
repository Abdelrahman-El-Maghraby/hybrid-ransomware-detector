# ============================================================================
# AEGIS SENTINEL v5.2.0 — Environment Configuration Template
# Copy this file to .env and populate only the services you wish to enable.
# ============================================================================

# --- Core Engine & Concurrency ----------------------------------------------
AEGIS_MAX_WORKERS=4
AEGIS_SCAN_DIRS=/Users/yourname/Downloads
AEGIS_CACHE_ENABLED=true
AEGIS_INTEGRITY_ENABLED=true

# --- LLM Semantic Layer (Local-First OPSEC Default) -------------------------
# Options: auto | ollama | openai | none
LLM_PROVIDER=auto
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- AES-256-GCM Quarantine Vault -------------------------------------------
AEGIS_QUARANTINE_ENABLED=false
AEGIS_QUARANTINE_MIN_VERDICT=High
AEGIS_QUARANTINE_KEY_ID=k1-default
# Optional 32-byte base64 master key or scrypt passphrase:
AEGIS_QUARANTINE_KEY_B64=
AEGIS_QUARANTINE_PASSPHRASE=

# --- External Threat Intelligence APIs --------------------------------------
VIRUSTOTAL_API_KEY=
AEGIS_VT_UPLOAD_UNSEEN=false
GOOGLE_SAFE_BROWSING_API_KEY=
IPQS_API_KEY=
ABUSEIPDB_API_KEY=

# --- Aegis MailGuard Authentication & Domain Protection ---------------------
AEGIS_TRUSTED_AUTHSERV=mx.google.com,google.com,protection.outlook.com,spf.protection.outlook.com
AEGIS_PROTECTED_DOMAINS=microsoft.com,google.com,paypal.com,apple.com,amazon.com,dhl.com
AEGIS_DKIM_LIVE_VERIFY=false
AEGIS_SPF_LIVE_VERIFY=false
AEGIS_DMARC_LIVE_LOOKUP=false

# --- Behavioral, Sandbox, Memory, Sigma & Deception Canaries ----------------
AEGIS_BEHAVIORAL_ENABLED=true
AEGIS_SANDBOX_ENABLED=true
AEGIS_SANDBOX_ALLOW_CONTAINER_EXEC=false
AEGIS_MEMORY_SCAN_ENABLED=false
AEGIS_SIGMA_ENABLED=true
AEGIS_CANARY_ENABLED=true
AEGIS_CANARY_AUTO_DEPLOY=false
AEGIS_ML_ENABLED=true
AEGIS_ML_THRESHOLD=0.60

# --- TCP Syslog SIEM Telemetry (CEF & JSON) ---------------------------------
AEGIS_SIEM_ENABLED=false
AEGIS_SIEM_HOST=127.0.0.1
AEGIS_SIEM_PORT=514
AEGIS_SIEM_FORMAT=both

# --- SMTP Critical Alerting -------------------------------------------------
AEGIS_SMTP_ENABLED=false
AEGIS_SMTP_HOST=smtp.gmail.com
AEGIS_SMTP_PORT=587
AEGIS_SMTP_USER=
AEGIS_SMTP_PASSWORD=
AEGIS_SMTP_SENDER=
AEGIS_SMTP_RECIPIENTS=soc-alerts@example.com

# --- Encrypted Cloud Sync & Central Fleet Console ---------------------------
AEGIS_CLOUD_SYNC_ENABLED=false
AEGIS_CLOUD_SYNC_ENDPOINT=
AEGIS_CLOUD_SYNC_API_KEY=
AEGIS_FLEET_AGENT_ID=
AEGIS_FLEET_AGENT_TOKEN=